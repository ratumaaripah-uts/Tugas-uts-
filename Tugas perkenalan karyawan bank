class KaryawanBank:
    nama = "Ratu"
    posisi = "Teller"
    cabang = "Tembong"

    def perkenalan(self):
        print(f"Halo, perkenalkan saya {self.nama}, karyawan baru sebagai {self.posisi} di Bank cabang {self.cabang}")

    def sapa(self, nama_teman):
        print(f"Halo {nama_teman}, saya {self.nama}. Salam kenal ya, mohon bimbingannya")

